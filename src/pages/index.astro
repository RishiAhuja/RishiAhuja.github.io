---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DecorativeArt from '../components/DecorativeArt.astro';
import { ArrowDownIcon, ArrowUpRightIcon } from '@heroicons/react/24/outline';
import { LINKS, PORTRAIT } from '../lib/constants';
import { FEATURED_SLUGS, paperCardAward, pubPath } from '../lib/research';
import { getWritings, writingPath } from '../lib/blogs';
import { paperArtwork, writingArtwork } from '../lib/artwork';
import CoverArt from '../components/CoverArt.astro';
import ExperienceList from '../components/ExperienceList.astro';
import { updates } from '../data/updates';

const papers = (await getCollection('research')).sort(
  (a, b) => b.data.sort_date.getTime() - a.data.sort_date.getTime()
);

const featured = FEATURED_SLUGS.map((slug) => papers.find((entry) => entry.slug === slug)).filter(
  (entry): entry is (typeof papers)[number] => Boolean(entry)
);

const latestWritings = (await getWritings()).slice(0, 3);



const monthDate = (label: string) => {
  const [month, year] = label.split(' ');
  const number = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'].indexOf(month) + 1;
  return `${year}-${String(number).padStart(2, '0')}`;
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Rishi Ahuja',
  url: 'https://rishia.in',
  image: new URL(PORTRAIT, Astro.site).toString(),
  jobTitle: 'Undergraduate Researcher',
  affiliation: [
    {
      '@type': 'CollegeOrUniversity',
      name: 'Dr. B.R. Ambedkar National Institute of Technology Jalandhar',
    },
    {
      '@type': 'CollegeOrUniversity',
      name: 'Northwestern University',
      url: LINKS.MHI,
    },
  ],
  sameAs: [
    LINKS.GITHUB,
    LINKS.LINKEDIN,
    LINKS.GOOGLE_SCHOLAR,
    LINKS.OPENREVIEW,
    LINKS.TWITTER,
    LINKS.MHI,
  ],
  knowsAbout: ['Trustworthy AI', 'Time Series Forecasting', 'Retrieval-Augmented Systems', 'Fraud Detection'],
};
---

<BaseLayout
  title="Rishi Ahuja"
  description="Undergraduate researcher pursuing a B.Tech. with Research in Information Technology at NIT Jalandhar, working on trustworthy AI evaluation, temporal retrieval, and conversational fraud detection."
>
  <link slot="head" rel="preload" as="image" href={PORTRAIT} fetchpriority="high" />
  <JsonLd data={schema} />
  <noscript slot="head"><style is:inline>[data-extra-update] { display: grid !important; }</style></noscript>

  <main id="main-content" tabindex="-1">
    <section class="hero wrap" id="home">
      <div class="hero-intro">
        <div>
          <h1>Hello 👋</h1>
          <p>
            I am <a class="intro-link" href="#about">Rishi Ahuja</a>, a 19-year-old undergraduate researcher pursuing a B.Tech. with
            Research in Information Technology at <a class="intro-link" href="https://www.nitj.ac.in/" target="_blank" rel="noopener noreferrer">NIT Jalandhar</a>, and an incoming
            intern at <a class="intro-link" href="/blurb/cisco-interview">Cisco</a>.
            {/*
            I also work at <span class="highlight">Northwestern University</span>.
            I also work with the{' '}
            <a class="highlight" href={LINKS.MHI}>Machine and Hybrid Intelligence Lab</a>
            {' '}at Northwestern University.
            */}
          </p>
          <p class="hero-note">
            My research focuses on building and evaluating reliable AI systems, with
            current work in language-model evaluation, temporal retrieval, and
            conversational fraud detection.
          </p>
        </div>
        <div class="hero-actions">
          <a class="button" href="/research">
            View research
            <ArrowUpRightIcon aria-hidden="true" />
          </a>
          <a class="button" href={LINKS.RESEARCH_RESUME} target="_blank" rel="noopener noreferrer">
            CV
            <ArrowDownIcon className="arrow-down" aria-hidden="true" />
          </a>
        </div>
      </div>
      <div class="hero-profile">
        <img
          class="hero-photo"
          src={PORTRAIT}
          alt="Rishi Ahuja"
          width="1268"
          height="1241"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </section>

    <section class="section wrap-wide" id="research">
      <h2 class="section-title">Featured research</h2>
      <div class="project-grid">
        {featured.map((paper) => {
          const awardLine = paperCardAward(paper.data);
          return (
          <article class="project-tile">
            <a
              class="project-cover-link"
              href={pubPath(paper.slug)}
              aria-label={`Read about ${paper.data.short_name}`}
              data-cover-prefetch={paperArtwork(paper.slug)?.heroAvif}
            >
              <div class={`project-cover ${paper.data.cover}`}>
                {paperArtwork(paper.slug) && (
                  <CoverArt cover={paperArtwork(paper.slug)!} variant="tile" />
                )}
              </div>
            </a>
            <div class="project-copy">
              <h3>
                <a class="project-name" href={pubPath(paper.slug)}>{paper.data.short_name}</a>
              </h3>
              {awardLine && (
                <p class="project-award-line">★ {awardLine}</p>
              )}
              <p class="project-desc">{paper.data.blurb}</p>
              <p class="project-venue">{paper.data.venue}</p>
            </div>
          </article>
          );
        })}
      </div>
      <p class="writing-more">
        <a class="button" href="/research">
          All research
          <ArrowUpRightIcon aria-hidden="true" />
        </a>
      </p>
    </section>

    <section class="section wrap" id="updates">
      <h2 class="section-title">Updates and awards</h2>
      <ul class="update-list" id="updates-list">
        {updates.map(([date, text], index) => (
          <li hidden={index >= 8} data-extra-update={index >= 8 ? '' : undefined}>
            <time datetime={monthDate(date)}>{date}</time>
            <span set:html={text} />
          </li>
        ))}
      </ul>
      <button class="updates-toggle" type="button" hidden aria-expanded="false" aria-controls="updates-list" data-remaining={updates.length - 8}>
        <span>Show {updates.length - 8} more</span> <span class="toggle-arrow" aria-hidden="true">↓</span>
      </button>
    </section>

    <section class="section wrap" id="experience" aria-labelledby="experience-title">
      <h2 class="section-title" id="experience-title">Experience</h2>
      <ExperienceList />
    </section>

    <section class="section wrap-wide" id="writings">
      <h2 class="section-title">Writing</h2>
      <div class="project-grid writing-grid">
        {latestWritings.map((post) => (
          <article class="project-tile">
            <a
              class="project-cover-link"
              href={writingPath(post.slug)}
              aria-label={`Read ${post.data.title}`}
              data-cover-prefetch={writingArtwork(post.slug)?.heroAvif}
            >
              <div class={`project-cover ${post.data.cover}`}>
                {writingArtwork(post.slug) && (
                  <CoverArt cover={writingArtwork(post.slug)!} variant="tile" />
                )}
              </div>
            </a>
            <div class="project-copy">
              <h3>
                <a class="project-name" href={writingPath(post.slug)}>{post.data.title}</a>
              </h3>
              <p class="project-desc">{post.data.brief}</p>
              <p class="project-venue">
                {post.data.dateAdded.toLocaleDateString('en-US', { year: 'numeric', month: 'short' })}
              </p>
            </div>
          </article>
        ))}
      </div>
      <p class="writing-more">
        <a class="button" href="/writings">
          All writing
          <ArrowUpRightIcon aria-hidden="true" />
        </a>
      </p>
    </section>

    <section class="section wrap" id="academics" aria-labelledby="academics-title">
      <h2 class="section-title" id="academics-title">Academics</h2>
      <article class="experience-row academic-row">
        <div class="organisation-logo"><img src="/images/logos/nitj.webp" alt="" width="60" height="60" loading="lazy" decoding="async" /></div>
        <div class="experience-copy"><h3><a class="organisation-name" href="https://www.nitj.ac.in/" target="_blank" rel="noopener noreferrer">NIT Jalandhar</a></h3><p class="experience-role">B.Tech. with Research in Information Technology</p><p class="experience-meta">Department of Information Technology</p><p class="experience-meta">Pre-final year</p></div>
        <p class="academic-date">2024–2028</p>
      </article>
    </section>

    <section class="section section-soft" id="about">
      <div class="wrap">
        <h2 class="section-title">About</h2>
        <div class="info-list">
          <article class="info-row">
            <p class="info-label">01 / Background</p>
            <div>
              <p>
                I am a 19-year-old undergraduate researcher pursuing a B.Tech. with Research
                in Information Technology at NIT Jalandhar. I study how AI systems
                can be evaluated reliably against the claims made about them.
                {/*
                I also work at <span class="highlight">Northwestern University</span>.
                I also work with the{' '}
                <a class="highlight" href={LINKS.MHI}>Machine and Hybrid Intelligence Lab</a>
                {' '}at Northwestern University.
                */}
              </p>
            </div>
          </article>
          <article class="info-row">
            <p class="info-label">02 / Research</p>
            <div>
              <p>
                My current work spans three projects:
                <a class="inline-tag blue" href={pubPath('ahuja2026icfd31k')}>ICFD-31k</a> in conversational fraud
                detection,
                <a class="inline-tag rose" href={pubPath('ahuja2026scopebenchpr')}>ScopeBench-PR</a> in scope fairness
                for LLM-assisted peer review, and
                <a class="inline-tag" href={pubPath('ahuja2026retrieval')}>selective retrieval</a> for time-series
                forecasting. Across them, I care about reliable evaluation under
                realistic conditions.
              </p>
            </div>
          </article>
          <article class="info-row">
            <p class="info-label">03 / Beyond Research</p>
            <div>
              <p>
                I write about machine learning, systems, and building software from
                first principles. The full archive is in
                <a href="/writings">Writing</a>.
              </p>
              <div class="gym-note">
                <div class="gym-art"><DecorativeArt kind="dumbbell" /></div>
                <p>
                  Outside work, I train hard in the gym and have lost a significant
                  amount of weight over the past year.
                </p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .gym-note { display: flow-root; margin-top: 12px; }
  .gym-art { float: right; width: 96px; margin: 0 0 6px 20px; }
  .gym-note p { margin: 0; }
  @media (max-width: 650px) { .gym-art { width: 80px; margin-left: 14px; } }
</style>
