---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { LINKS } from '../lib/constants';
---
<BaseLayout title="Résumés · Rishi Ahuja" description="Engineering experience and academic work, in two focused documents.">
  <main id="main-content" tabindex="-1">
    <section class="section wrap supporting-page">
      <div class="page-path"><Breadcrumbs items={[{ label: 'Home', href: '/' }]} /><h1 class="page-title">Résumés</h1></div>
      <p class="page-lede">Engineering experience and academic work, in two focused documents.</p>
      <div class="resume-list">
        <article><p class="info-label">01 / Research</p><h2>Research CV</h2><p>Papers, academic work, research experience, and service.</p><a class="button" href={LINKS.RESEARCH_RESUME} target="_blank" rel="noopener noreferrer">Open research CV <span aria-hidden="true">↗</span></a></article>
        <article><p class="info-label">02 / Engineering</p><h2>Engineering résumé</h2><p>Software engineering, internships, and experience building systems.</p><a class="button" href={LINKS.ENGINEERING_RESUME} target="_blank" rel="noopener noreferrer">Open engineering résumé <span aria-hidden="true">↗</span></a></article>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
