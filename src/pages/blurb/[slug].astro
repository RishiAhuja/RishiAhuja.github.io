---
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import { paperBlurbs, publishedBlurbs, blurbPath } from '../../lib/blurbs';
import { pubPath } from '../../lib/research';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ArticleSignature from '../../components/ArticleSignature.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CoverArt from '../../components/CoverArt.astro';
import CoverPreload from '../../components/CoverPreload.astro';
import BlurbContent from '../../components/blurb/BlurbContent.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { blurbPosts, type BlurbPost } from '../../data/blurb';
import { blurbArtwork } from '../../lib/artwork';
import { formatPostDate } from '../../lib/blogs';
import { hasWritingToc } from '../../lib/blogMarkdown';
import { blurbHeadings } from '../../lib/blurbToc.ts';


export const getStaticPaths = (() => {
  return blurbPosts
    .filter((post) => post.status === 'published')
    .map((post) => ({
      params: { slug: post.slug },
      props: { post },
    }));
}) satisfies GetStaticPaths;

const { post } = Astro.props as { post: BlurbPost };
const published = formatPostDate(new Date(`${post.publishedDate}T00:00:00`));
const headings = blurbHeadings(post.content);
const showToc = hasWritingToc(headings);
const artwork = blurbArtwork(post.slug);
const cover = post.cover || 'mist';
const relatedPapers = (await getCollection('research')).filter((paper) => paperBlurbs[paper.slug]?.includes(post.slug));
const relatedBlurbs = publishedBlurbs().filter((note) => note.slug !== post.slug).sort((a, b) => Number(b.category === post.category) - Number(a.category === post.category)).slice(0, 2);
const hasTwitter = post.content.some((item) => item.type === 'twitter' && item.tweetId && item.tweetId.length >= 15);
---

<BaseLayout title={`${post.title} · Rishi Ahuja`} description={post.description} cover={cover}>
  <CoverPreload slot="head" cover={artwork} variant="hero" />
  {hasTwitter && <script is:inline slot="head" async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>}

  <main id="main-content" tabindex="-1">
    <section class={`writing-hero ${cover}`}>
      <div class="wrap project-hero-grid">
        <div class="project-intro">
          <div>
            <div class="page-path">
              <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: 'Blurbs', href: '/blurb' }]} />
              <h1>{post.title}</h1>
            </div>
            <p class="project-authors">Rishi Ahuja</p>
            <p class="project-lede">{post.subtitle || post.description}</p>
          </div>
          <div class="project-hero-meta">
            <p class="project-info">
              <time datetime={post.publishedDate}>{published}</time>
              {post.readTime && <span> · {post.readTime} min read</span>}
            </p>
          </div>
        </div>
        {artwork && (
          <div class={`project-hero-cover ${cover}`}>
            <CoverArt cover={artwork} variant="hero" priority />
          </div>
        )}
      </div>
    </section>

    <article class={`project-body wrap writing-with-toc${showToc ? ' has-toc' : ''}`}>
      <TableOfContents items={headings} />
      <div class="blog-main blurb-page">
        <BlurbContent content={post.content} />
        <ArticleSignature />
      </div>
    </article>
    {relatedPapers.length > 0 && <section class="section wrap"><h2 class="section-title">Research from this trip</h2><div class="related-grid">{relatedPapers.map((paper) => <a class="related-card" href={pubPath(paper.slug)}><p class="project-venue">{paper.data.venue}</p><h3>{paper.data.short_name}</h3><p>{paper.data.blurb}</p></a>)}</div></section>}
    <section class="section wrap"><h2 class="section-title">More blurbs</h2><div class="related-grid">{relatedBlurbs.map((note) => <a class="related-card" href={blurbPath(note.slug)}><h3>{note.title}</h3><p>{note.subtitle || note.description}</p></a>)}</div></section>
  </main>

  <SiteFooter />
</BaseLayout>
