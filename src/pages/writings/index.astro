---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { ArrowUpRightIcon } from '@heroicons/react/24/outline';
import { getWritings, writingPath } from '../../lib/blogs';
import { writingArtwork } from '../../lib/artwork';
import CoverArt from '../../components/CoverArt.astro';

const posts = await getWritings();
---

<BaseLayout
  title="Writing · Rishi Ahuja"
  description="Technical writing on systems, machine learning, and the machinery underneath."
>
  <main id="main-content" tabindex="-1">
    <section class="section wrap">
      <div class="page-path">
        <Breadcrumbs items={[{ label: 'Home', href: '/' }]} />
        <h1 class="page-title">Writing</h1>
      </div>
      <p class="page-lede">
        Explorations of systems, protocols, and models, with explanations built from first principles.
      </p>
      <div class="project-grid writing-grid">
        {posts.map((post, index) => (
          <article class="project-tile">
            <a
              class="project-cover-link"
              href={writingPath(post.slug)}
              aria-label={`Read ${post.data.title}`}
              data-cover-prefetch={writingArtwork(post.slug)?.heroAvif}
            >
              <div class={`project-cover ${post.data.cover}`}>
                {writingArtwork(post.slug) && (
                  <CoverArt cover={writingArtwork(post.slug)!} variant="card" priority={index === 0} />
                )}
              </div>
            </a>
            <h2>
              <a class="project-name" href={writingPath(post.slug)}>{post.data.title}</a>
            </h2>
            <p class="project-desc">{post.data.brief}</p>
            <p class="project-venue">{post.data.dateAdded.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })} · {post.data.readTimeInMinutes} min read</p>
          </article>
        ))}
      </div>
      <p class="writing-hashnode">
        <a class="button" href="https://rishi2220.hashnode.dev" target="_blank" rel="noopener noreferrer">
          Hashnode
          <ArrowUpRightIcon aria-hidden="true" />
        </a>
      </p>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
