---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { paperAwardMarks, pubPath, resourceLabel } from '../../lib/research';
import { paperArtwork } from '../../lib/artwork';
import CoverArt from '../../components/CoverArt.astro';
const papers = (await getCollection('research')).sort((a, b) => b.data.sort_date.getTime() - a.data.sort_date.getTime());
---
<BaseLayout title="Research · Rishi Ahuja" description="Papers and benchmarks on trustworthy evaluation, temporal retrieval, and conversational fraud detection.">
  <main id="main-content" tabindex="-1">
    <section class="section wrap">
      <div class="page-path"><Breadcrumbs items={[{ label: 'Home', href: '/' }]} /><h1 class="page-title">Research</h1></div>
      <p class="page-lede">Benchmarks and papers on evaluating AI systems against the claims they actually make.</p>
      <div class="research-records">
        {papers.map((paper, index) => <article class="research-record">
          <a class="research-thumbnail project-cover-link" href={pubPath(paper.slug)} aria-label={`Read about ${paper.data.short_name}`} data-cover-prefetch={paperArtwork(paper.slug)?.heroAvif}>
            <div class={`project-cover ${paper.data.cover}`}>{paperArtwork(paper.slug) && <CoverArt cover={paperArtwork(paper.slug)!} priority={index === 0} />}</div>
          </a>
          <div class="research-record-content">
            <p class="research-status">{paper.data.status === 'published' ? 'Published' : 'Accepted'} · {paper.data.sort_date.getUTCFullYear()}</p>
            <h2><a href={pubPath(paper.slug)}>{paper.data.title}</a></h2>
            <p class="research-authors">{paper.data.authors.map((author, index) => <><span class={author.is_me ? 'author-me' : undefined}>{author.name}</span>{index < paper.data.authors.length - 1 ? ', ' : ''}</>)}</p>
            <p class="research-venue">{paper.data.venue}</p>
            {paperAwardMarks(paper.data).map((award) => <p class="project-award-line"><span aria-hidden="true">★</span> {award}</p>)}
            <p class="project-desc">{paper.data.blurb}</p>
            <ul class="project-links" aria-label={`Resources for ${paper.data.short_name}`}>
              {paper.data.links.map((link) => <li><a href={link.url} target="_blank" rel="noopener noreferrer">{resourceLabel(link.label)} <span aria-hidden="true">↗</span></a></li>)}
              <li><a href={pubPath(paper.slug)}>Details <span aria-hidden="true">→</span></a></li>
            </ul>
          </div>
        </article>)}
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>
