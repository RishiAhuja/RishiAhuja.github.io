---
import '../styles/site.css';
import Header from '../components/Header.astro';
import { ViewTransitions } from 'astro:transitions';
import { OG_WIDTH, OG_HEIGHT, normalizePagePath, ogImagePath } from '../lib/og';
import { ARCHIVE_ORIGIN } from '../lib/siteConfig.mjs';
import { TWITTER_HANDLE } from '../lib/constants';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  cover?: string;
  canonical?: string;
  indexable?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title = 'Rishi Ahuja',
  description = 'Undergraduate researcher working on trustworthy AI evaluation, temporal retrieval, and conversational fraud detection.',
  image = ogImagePath(Astro.url.pathname),
  imageWidth = OG_WIDTH,
  imageHeight = OG_HEIGHT,
  imageType = 'image/png',
  imageAlt = title,
  ogType = /^\/(?:pub|blurb|writings|work)\/[^/]+/.test(Astro.url.pathname) ? 'article' : 'website',
  cover, canonical, indexable = true, publishedTime, modifiedTime,
} = Astro.props;

// Vercel serves paths without a trailing slash, so canonical URLs must too.
const pageURL = new URL(normalizePagePath(Astro.url.pathname), Astro.site);
const canonicalURL = canonical ? new URL(canonical) : pageURL;
const imageURL = new URL(image, Astro.site).toString();
const isInner = Astro.url.pathname !== '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, follow" />}
    <link rel="alternate" type="application/rss+xml" title="Rishi Ahuja — Writing and blurbs" href="/feed.xml" />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:site_name" content="Rishi Ahuja" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={pageURL} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && <meta property="article:author" content="Rishi Ahuja" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={TWITTER_HANDLE} />
    <meta name="twitter:creator" content={TWITTER_HANDLE} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <ViewTransitions fallback="none" />
    <slot name="head" />
  </head>
  <body data-analytics-endpoint={import.meta.env.PUBLIC_ANALYTICS_ENDPOINT || 'https://rishia.in/api/visitors'} data-archive-origin={ARCHIVE_ORIGIN} class={[isInner ? 'is-inner' : 'is-home', cover && `cover-${cover}`].filter(Boolean).join(' ')}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <slot />
    <script>
      import '../scripts/siteMotion';
      import '../scripts/legacyFragments';
      import '../scripts/analytics';
      import '../scripts/age';
    </script>
  </body>
</html>
