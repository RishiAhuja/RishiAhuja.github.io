---
import '../styles/site.css';
import Header from '../components/Header';
import { OG_WIDTH, OG_HEIGHT, ogImagePath } from '../lib/og';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  imageAlt?: string;
  ogType?: 'website' | 'article';
  cover?: string;
}

const {
  title = 'Rishi Ahuja',
  description = 'Undergraduate researcher working on trustworthy AI evaluation, temporal retrieval, and conversational fraud detection.',
  image = ogImagePath(Astro.url.pathname),
  imageWidth = OG_WIDTH,
  imageHeight = OG_HEIGHT,
  imageType = 'image/png',
  imageAlt = title,
  ogType = /^\/(?:pub|blurb|writings)\/[^/]+/.test(Astro.url.pathname) ? 'article' : 'website',
  cover,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(image, Astro.site).toString();
const isInner = Astro.url.pathname !== '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <slot name="head" />
  </head>
  <body class={[isInner ? 'is-inner' : 'is-home', cover && `cover-${cover}`].filter(Boolean).join(' ')}>
    <Header client:load />
    <slot />
    <script>
      const warmed = new Set<string>();

      const prefetchCover = (url: string) => {
        if (!url || warmed.has(url) || document.querySelector(`link[href="${url}"]`)) return;
        warmed.add(url);
        const link = document.createElement('link');
        link.rel = 'prefetch';
        link.as = 'image';
        link.href = url;
        document.head.appendChild(link);
      };

      const fromTarget = (target: EventTarget | null) => {
        if (!(target instanceof Element)) return;
        const host = target.closest('[data-cover-prefetch]');
        if (host instanceof HTMLElement) prefetchCover(host.dataset.coverPrefetch ?? '');
      };

      document.addEventListener('pointerenter', (event) => fromTarget(event.target), true);
      document.addEventListener('focusin', (event) => fromTarget(event.target));
      document.addEventListener(
        'touchstart',
        (event) => fromTarget(event.target),
        { capture: true, passive: true },
      );
    </script>
  </body>
</html>
