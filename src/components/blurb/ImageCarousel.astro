---
interface Props {
  images: { src: string; alt: string }[];
  caption?: string;
}
const { images, caption } = Astro.props;
const first = images[0];
---
{first && (
  <figure class="media-carousel" data-images={JSON.stringify(images)} data-caption={caption ?? ''}
    tabindex={images.length > 1 ? 0 : undefined}
    aria-roledescription={images.length > 1 ? 'carousel' : undefined}
    aria-label={caption || `Image carousel with ${images.length} images`}>
    <div class="carousel-stage">
      {images.length > 1 && <button class="carousel-arrow" type="button" data-direction="-1" aria-label="Previous image">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M15 19l-7-7 7-7" /></svg>
      </button>}
      <div class="blurb-media-frame">
        <img src={first.src} alt={first.alt} loading="lazy" decoding="async" class="blurb-media-image" />
        {images.length > 1 && <span class="carousel-counter" aria-hidden="true">1 / {images.length}</span>}
      </div>
      {images.length > 1 && <button class="carousel-arrow" type="button" data-direction="1" aria-label="Next image">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>}
    </div>
    {images.length > 1 && <div class="carousel-dots" role="group" aria-label="Choose an image">
      {images.map((_, index) => <button class="carousel-dot" type="button" data-slide={index}
        aria-label={`Show image ${index + 1} of ${images.length}`} aria-current={index === 0 ? 'true' : undefined} />)}
    </div>}
    <figcaption>{caption || first.alt}</figcaption>
    <span class="sr-only carousel-announcement" aria-live="polite" aria-atomic="true" />
  </figure>
)}
