---
const stops = [
  { name: 'Your laptop', detail: 'Wherever you are.', image: 'client' },
  { name: 'Relay', detail: 'The meeting point.', image: 'relay' },
  { name: 'Campus laptop', detail: 'Holding the fort.', image: 'bastion' },
  { name: 'Compute cluster', detail: 'Your experiments.', image: 'hpc' },
];
---
<figure class="pogo-route" aria-label="The connection from your laptop, through a relay and campus laptop, to the compute cluster">
  <ol class="route-stops">
    {stops.map((stop, index) => <li class="route-stop">
      <img src={`/images/work/pogo/${stop.image}.webp`} width="360" height="300" alt="" decoding="async" />
      <div class="route-copy"><strong>{stop.name}</strong><span>{stop.detail}</span></div>
      {index < stops.length - 1 && <span class="route-hop" aria-hidden="true" />}
    </li>)}
  </ol>
</figure>
<style>
  .pogo-route { margin: 3rem 0 0; }
  .route-stops { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); margin: 0; padding: 0; list-style: none; }
  .route-stop { position: relative; min-width: 0; text-align: center; }
  .route-stop img { display: block; width: min(100%,170px); height: 142px; object-fit: contain; margin: 0 auto 0.65rem; }
  .route-copy strong { display: block; font-size: 1rem; font-weight: 600; }
  .route-copy > span { display: block; margin-top: 0.15rem; color: var(--text-muted); font-size: 0.8rem; }
  .route-hop { position: absolute; left: calc(50% + 76px); top: 71px; width: calc(100% - 152px); height: 1px; background: color-mix(in srgb,var(--accent) 55%,transparent); }
  @media (hover:hover) and (pointer:fine) and (prefers-reduced-motion:no-preference) {
    .route-stop img { transition: transform 160ms ease-out; }
    .route-stop:hover img { transform: translateY(-3px); }
  }
  @media (min-width: 761px) and (max-width: 1000px) {
    .route-stop img { width: 120px; height: 100px; }
    .route-hop { top: 52px; left: calc(50% + 56px); width: calc(100% - 112px); }
  }
  @media (max-width: 760px) {
    .pogo-route { margin-top: 2rem; }
    .route-stops { display: block; }
    .route-stop { display: grid; grid-template-columns: 82px 1fr; align-items: center; gap: 0.9rem; text-align: left; min-height: 88px; }
    .route-stop img { width: 82px; height: 76px; margin: 0; }
    .route-copy strong { font-size: 0.95rem; }
    .route-copy > span { font-size: 0.78rem; }
    .route-hop { display: none; }
  }
</style>
