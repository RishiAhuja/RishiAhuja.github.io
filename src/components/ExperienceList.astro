---
import { experiences } from '../data/experience';
---
<div class="experience-list">
  {experiences.map((item) => {
    const external = item.href.startsWith('https:');
    return (
      <article class="experience-row">
        <div class="organisation-logo"><img src={item.logo} alt="" width="48" height="48" loading="lazy" decoding="async" /></div>
        <div class="experience-copy">
          <h3><a href={item.href} class="organisation-name" target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>{item.organisation}</a></h3>
          {item.context && <p class="organisation-context">{item.context}</p>}
          <ol class:list={['experience-roles', { 'has-progression': item.roles.length > 1 }]} aria-label={`${item.organisation} roles`}>
            {item.roles.map((role) => (
              <li>
                <p class="experience-role">{role.title}</p>
                <p class="experience-meta"><span class:list={['experience-date', { 'is-upcoming': role.upcoming }]}>{role.date}</span>{role.meta && <> · {role.meta}</>}</p>
              </li>
            ))}
          </ol>
        </div>
      </article>
    );
  })}
</div>
