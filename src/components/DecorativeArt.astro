---
type Artwork = 'colophon' | 'archive' | 'community' | 'links' | 'dumbbell' | 'curriculum' | 'bookmark';
interface Props { kind: Artwork; loading?: 'eager' | 'lazy'; }
const { kind, loading = 'lazy' } = Astro.props;
const singleImages = {
  colophon: '/images/supporting/colophon.webp',
  links: '/images/supporting/links.webp',
  dumbbell: '/images/personal/dumbbell.webp',
  curriculum: '/images/personal/curriculum.webp',
  bookmark: '/images/personal/bookmark.webp',
};
const communityPieces = [
  { name: 'ivory', width: 256, height: 193 },
  { name: 'blue', width: 185, height: 256 },
  { name: 'teal', width: 169, height: 256 },
  { name: 'slate', width: 256, height: 172 },
  { name: 'clay', width: 196, height: 256 },
];
---

<span class={`decorative-art art-${kind}`} aria-hidden="true">
  {kind === 'archive' ? (
    ['back', 'middle', 'front'].map(card => (
      <img class={`art-piece card-${card}`} src={`/images/supporting/archive-layers/${card}.webp`} width="360" height="270" alt="" loading={loading} decoding="async" />
    ))
  ) : kind === 'community' ? (
    <>
      <img class="art-piece community-thread" src="/images/supporting/community-layers/thread.webp" width="256" height="256" alt="" loading={loading} decoding="async" />
      {communityPieces.map(piece => <img class={`art-piece community-${piece.name}`} src={`/images/supporting/community-layers/${piece.name}.webp`} width={piece.width} height={piece.height} alt="" loading={loading} decoding="async" />)}
    </>
  ) : (
    <img class="art-whole" src={singleImages[kind]} width="480" height={kind === 'dumbbell' ? 240 : kind === 'bookmark' ? 320 : 480} alt="" loading={loading} decoding="async" />
  )}
</span>

<style>
  .decorative-art { display: block; position: relative; width: 100%; aspect-ratio: 1; isolation: isolate; }
  .art-dumbbell { aspect-ratio: 2; }
  .art-bookmark { aspect-ratio: 3 / 2; }
  .art-whole { width: 100%; height: 100%; object-fit: contain; }
  .art-piece { position: absolute; object-fit: contain; }

  .art-archive .art-piece { width: 78%; height: 58%; transform-origin: 50% 80%; }
  .card-back { left: 17%; top: 34%; z-index: 1; }
  .card-middle { left: 11%; top: 24%; z-index: 2; }
  .card-front { left: 3%; top: 13%; z-index: 3; }

  .community-thread { width: 82%; height: 82%; left: 9%; top: 10%; z-index: 0; }
  .art-community .art-piece:not(.community-thread) { z-index: 1; }
  .community-ivory { width: 57%; height: 36%; left: 25%; top: 4%; }
  .community-blue { width: 34%; height: 52%; left: 4%; top: 25%; }
  .community-teal { width: 32%; height: 50%; left: 64%; top: 25%; }
  .community-slate { width: 54%; height: 34%; left: 20%; top: 66%; }
  .community-clay { width: 27%; height: 35%; left: 66%; top: 64%; }

  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .art-whole, .art-piece { transition: transform 220ms cubic-bezier(.2,.7,.2,1); }
    .art-colophon:hover .art-whole { transform: translateY(-2px) rotate(-1.5deg); }
    .art-links:hover .art-whole { transform: scale(1.025); }
    .art-archive:hover .card-front { transform: translate(-2px, -3px) rotate(-2deg); }
    .art-archive:hover .card-middle { transform: translate(1px, -1px) rotate(.75deg); }
    .art-archive:hover .card-back { transform: translate(2px, 1px) rotate(1.5deg); }
    .art-community:hover .community-ivory { transform: translateY(2px); }
    .art-community:hover .community-blue { transform: translateX(2px); }
    .art-community:hover .community-teal { transform: translateX(-2px); }
    .art-community:hover .community-slate { transform: translateY(-2px); }
    .art-community:hover .community-clay { transform: translate(-1px, -2px); }
    .art-community:hover .community-thread { transform: scale(.99); }
    .art-curriculum:hover .art-whole { transform: translateY(-2px) rotate(-1deg); }
    .art-bookmark:hover .art-whole { transform: translateY(-2px) rotate(-1deg); }
    .art-dumbbell:hover .art-whole { animation: dumbbell-lift 320ms ease-in-out 1; }
  }

  @keyframes dumbbell-lift {
    0% { transform: translateY(0) rotate(0); }
    25% { transform: translateY(-2px) rotate(-3deg); }
    50% { transform: translateY(-5px) rotate(-6deg); }
    75% { transform: translateY(-2px) rotate(-3deg); }
    100% { transform: translateY(0) rotate(0); }
  }
</style>
