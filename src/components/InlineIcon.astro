---
import { ArrowUpRightIcon, HeartIcon } from '@heroicons/react/24/outline';

interface Props { name: 'arrow-up-right' | 'heart'; class?: string; }
const { name, class: className } = Astro.props;
const Icon = { 'arrow-up-right': ArrowUpRightIcon, heart: HeartIcon }[name];
---

<span class:list={['inline-icon', className]} aria-hidden="true">
  <Icon />
</span>

<style>
  .inline-icon {
    display: inline-flex;
    width: 1em;
    height: 1em;
    flex-shrink: 0;
    vertical-align: -.125em;
  }
  .inline-icon :global(svg) { display: block; width: 100%; height: 100%; }
</style>
