---
import { nestToc, type TocItem } from '../lib/blogMarkdown';
interface Props { items: TocItem[]; }
const tree = nestToc(Astro.props.items);
---
{tree.length >= 2 && (
  <aside class="toc" aria-label="Article contents">
    <details class="toc-disclosure">
      <summary>On this page</summary>
      <nav aria-label="On this page">
        <ol class="toc-list">
          {tree.map((node) => (
            <li class={node.children.length > 0 ? 'has-sub' : undefined}>
              <a href={`#${node.item.id}`}>{node.item.text}</a>
              {node.children.length > 0 && <div class="toc-sub-wrap"><ol class="toc-sub">
                {node.children.map((child) => <li><a href={`#${child.id}`}>{child.text}</a></li>)}
              </ol></div>}
            </li>
          ))}
        </ol>
      </nav>
    </details>
  </aside>
)}
