---
import { siGithub, siGooglescholar } from 'simple-icons';
import { LINKS } from '../lib/constants';

const LINKEDIN_PATH = 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C0 .774 23.2 0 22.222 0h.003z';
const path = Astro.url.pathname;
const active = path.startsWith('/pub') || path.startsWith('/research') ? 'research'
  : path.startsWith('/writings') ? 'writings'
  : path.startsWith('/community') || path.startsWith('/flutter-bootcamp') ? 'community'
  : path.startsWith('/resume') ? 'resume'
  : path === '/' ? 'home' : '';
const navigation = [
  { id: 'home', label: 'Home', href: '/' },
  { id: 'research', label: 'Research', href: '/research' },
  { id: 'writings', label: 'Writing', href: '/writings' },
  { id: 'community', label: 'Community', href: '/community' },
  { id: 'about', label: 'About', href: '/#about' },
  { id: 'resume', label: 'Résumé', href: LINKS.RESUME, external: false },
];
const socials = [
  { label: 'Google Scholar', href: LINKS.GOOGLE_SCHOLAR, path: siGooglescholar.path },
  { label: 'GitHub', href: LINKS.GITHUB, path: siGithub.path },
  { label: 'LinkedIn', href: LINKS.LINKEDIN, path: LINKEDIN_PATH },
];
---
<header class="site-header" style="view-transition-name: site-header;">
  <nav class="site-nav wrap" aria-label="Main navigation" data-open="false">
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav-panel" aria-label="Open menu">
      <span class="nav-toggle-bars" aria-hidden="true"><span /><span /><span /></span>
    </button>
    <div class="nav-panel" id="main-nav-panel">
    <ul class="nav-links" id="main-nav-links">
      {navigation.map((item) => (
        <li><a href={item.href} data-nav-id={item.id} data-active={String(active === item.id)}
          aria-current={active === item.id ? 'page' : undefined}
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}>{item.label}</a></li>
      ))}
    </ul>
    <ul class="nav-social" id="main-nav-social">
      {socials.map((item) => (
        <li><a href={item.href} target="_blank" rel="noopener noreferrer" aria-label={item.label}>
          <svg class="icon-brand" viewBox="0 0 24 24" aria-hidden="true"><path d={item.path} /></svg>
        </a></li>
      ))}
    </ul>
    </div>
    <span class="nav-indicator" aria-hidden="true" style="view-transition-name: nav-indicator;" hidden />
  </nav>
</header>
