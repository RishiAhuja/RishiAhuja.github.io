<span class="publication-new">
  <svg class="publication-new-sparkle" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
    <path d="m14 3 2.5 6.5L23 12l-6.5 2.5L14 21l-2.5-6.5L5 12l6.5-2.5L14 3ZM4 1l1.1 2.9L8 5 5.1 6.1 4 9 2.9 6.1 0 5l2.9-1.1L4 1Zm0 14 1.1 2.9L8 19l-2.9 1.1L4 23l-1.1-2.9L0 19l2.9-1.1L4 15Z" />
  </svg>
  <span>New</span>
</span>

<script>
  const armSparkles = () => {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    document.querySelectorAll('.publication-new').forEach((badge) => {
      if (!(badge instanceof HTMLElement) || badge.dataset.sparkleBound) return;
      badge.dataset.sparkleBound = 'true';
      badge.addEventListener('mouseenter', () => {
        const icon = badge.querySelector('.publication-new-sparkle');
        if (!(icon instanceof SVGElement)) return;
        icon.classList.remove('is-sparkling');
        void icon.getBoundingClientRect();
        icon.classList.add('is-sparkling');
      });
    });
  };

  armSparkles();
  document.addEventListener('astro:page-load', armSparkles);
</script>

<style>
  .publication-new {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    margin: 0;
    color: var(--text-muted);
    font-size: 0.55em;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .publication-new-sparkle {
    display: inline-block;
    color: inherit;
    width: 1.3em;
    height: 1.3em;
    flex: none;
    transform-origin: 50% 65%;
  }

  .publication-new-sparkle.is-sparkling {
    animation: publication-sparkle 200ms ease-out 1;
  }

  @keyframes publication-sparkle {
    0%, 100% { transform: rotate(0deg) scale(1); }
    45% { transform: rotate(-8deg) scale(1.1); }
  }
</style>
